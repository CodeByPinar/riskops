{
    "name": "codebypinar/riskops",
    "description": "IT & Cyber Risk Management — PHP 8.3, no framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "RiskOps\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './storage/*' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
