{
    "name": "codebypinar/riskops",
    "description": "IT & Cyber Risk Management — PHP 8.3, no framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "RiskOps\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit --testsuite unit --bootstrap tests/bootstrap-unit.php",
        "test:integration": "phpunit --testsuite integration --bootstrap tests/bootstrap-app.php",
        "lint": "php tools/check_conventions.php",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "quality": [
            "@lint",
            "@cs",
            "@stan"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    }
}
