# RiskOps: bu dizine dogrudan HTTP erisimi yasak
#
# Loglar, yuklemeler ve marka kaynak dosyalari burada durur.
# VM kurulumunda VirtualHost da engelliyor; paylasilan hostingde
# (InfinityFree gibi) VirtualHost'a erisim YOKTUR - tek koruma budur.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
