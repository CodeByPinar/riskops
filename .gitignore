# =====================================================================
#  RiskOps - .gitignore
#
#  KURAL: Depoya giren her dosya herkese açıktır. Bir parolayı bir kez
#  push ettiyseniz, sonraki commit'te silmek YETMEZ - git geçmişinde
#  durmaya devam eder. Bu dosya, o hatayı baştan engellemek içindir.
# =====================================================================

# ---------------------------------------------------------------------
#  GİZLİ BİLGİ - asla commit edilmez
# ---------------------------------------------------------------------
/config/database.php
/config/*.local.php
.env
*.pem
*.key

# ---------------------------------------------------------------------
#  ÇALIŞMA ZAMANI VERİSİ
#  storage/ uygulamanın yazdığı yerdir: log, yükleme, önbellek.
#  Dizinin kendisi lazım, içeriği değil - bkz. storage/.gitkeep
# ---------------------------------------------------------------------
/storage/*
!/storage/.gitkeep
# .htaccess koruma dosyasidir, calisma zamani verisi degil: depoya girmeli.
# Paylasilan hostingde storage/ icin TEK koruma budur (VirtualHost yok).
!/storage/.htaccess
!/storage/brand/
/storage/brand/*
!/storage/brand/.gitkeep

# ---------------------------------------------------------------------
#  YEDEKLER VE GEÇİCİ DOSYALAR
# ---------------------------------------------------------------------
*.bak
*.old
*.orig
*.log
*.sql.gz
/backups/

# ---------------------------------------------------------------------
#  İŞLETİM SİSTEMİ / EDİTÖR
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------
#  Gelistirme araclarinin uretikleri
#
#  assets/vendor/ DEPODA DURUR (Bootstrap, Chart.js, ikonlar): uygulama
#  CDN kullanmiyor ve kurulumun internet gerektirmemesi bilincli bir
#  karar. Asagidaki vendor/ ise COMPOSER'in dizini - o baska.
# ---------------------------------------------------------------------
/vendor/
/.phpunit.cache/
.php-cs-fixer.cache
/composer.lock
.phpunit.result.cache

# ---------------------------------------------------------------------
#  Eklentiler
#
#  plugins/ DEPODA DURUR - ornek eklenti belge niteliginde.
#  Ucuncu taraf eklentiler operator tarafindan sunucuya konur ve bu
#  depoya girmez; alt dizinleri yok saymiyoruz cunku her kurulum
#  kendi eklentilerini kendi deposunda tutabilir.
#
#  Acik eklenti listesi ise kuruluma ozeldir.
# ---------------------------------------------------------------------
/storage/plugins.json
